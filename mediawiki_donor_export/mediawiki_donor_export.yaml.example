# Deploy as /etc/fundraising/mediawiki_donor_export.yaml,
# or $HOME/.fundraising/mediawiki_donor_export.yaml

# Directory which will stage the output CSV
working_path: /tmp/mediawiki_donor_export/

# Number of days worth of data to export (based on modified_date).
# Omit or set to null for a full export of all contacts.
offset_in_days: 3

# Optional: age public key (age1...) to encrypt the output for.
# This is the recipient's public key, not a private key. The recipient
# keeps the private key, so this server cannot decrypt the output.
# The recipient generates a key pair with: age-keygen -o identity.txt
# and gets the public key to send us with: age-keygen -y identity.txt
# The recipient decrypts with: age -d -i identity.txt -o FILE.csv FILE.age
# age_recipient: age1...

# Optional: SFTP upload destination
# sftp:
#     host: sftp.example.org
#     username: donor-export
#     private_key: "-----BEGIN RSA PRIVATE KEY-----\n..."
#     remote_root: /incoming/

# Silverpop database (where silverpop_export_view_full lives)
silverpop_db:
    host: database
    user: root
    passwd: ""
    db: silverpop
    debug: false

logging:
    disable_existing_loggers: false
    version: 1

    formatters:
        app_prefixed:
            format: "mediawiki-donor-export: %(message)s\n"

    handlers:
        console:
            class: logging.StreamHandler
            stream: ext://sys.stdout

        error:
            class: logging.StreamHandler
            level: ERROR

    root:
        level: DEBUG
        handlers:
            - console
            - error
